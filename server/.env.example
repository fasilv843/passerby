PORT=3000
REDIS_URL=redis://localhost:6379
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional. Defaults to Google's public STUN server.
STUN_URLS=stun:stun.l.google.com:19302

# Optional. TURN is offered only when both are set. See deploy/coturn/README.md.
TURN_URLS=
TURN_SECRET=
TURN_TTL=3600

# Milliseconds a user waits at each search stage (exact → language → anyone).
MATCH_WIDEN_MS=10000

# Group rooms (mediasoup SFU). See ../docs/group-rooms.md.
# Public IP or hostname browsers use to reach the SFU (127.0.0.1 only works on this machine).
SFU_ANNOUNCED_ADDRESS=127.0.0.1
SFU_LISTEN_IP=0.0.0.0
SFU_MIN_PORT=40000
SFU_MAX_PORT=40100
SFU_WORKERS=1
GROUP_MAX_PEERS=6
